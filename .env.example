# ══════════════════════════════════════════════════════════
# APEX HRIS Enterprise – Environment Variables
# ══════════════════════════════════════════════════════════
# IMPORTANT: Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ══════════════════════════════════════════════════════════

# ── Key Manager (P0 – Critical) ──────────────────────────
# Master key for PBKDF2 key derivation.
# Generate a secure random value: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
VITE_APEX_MASTER_KEY=CHANGE_ME_USE_A_STRONG_48_CHAR_RANDOM_HEX_STRING

# Per-branch QR signing secret for HMAC-SHA256 QR tokens.
# Must be different from the master key.
VITE_APEX_QR_SECRET=CHANGE_ME_DIFFERENT_STRONG_RANDOM_SECRET

# ── Backend API ───────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8080/api
VITE_API_TIMEOUT_MS=10000

# ── Session Security ──────────────────────────────────────
# These are read-only config values (safe to expose in frontend)
VITE_SESSION_IDLE_TIMEOUT_MIN=15
VITE_SESSION_ABSOLUTE_TIMEOUT_HOURS=8

# ── Feature Flags ─────────────────────────────────────────
# Set to 'true' to enable dynamic HMAC QR (requires backend support)
VITE_ENABLE_DYNAMIC_QR=false
# Set to 'true' to enable MFA enrollment flow
VITE_ENABLE_MFA=false
