PORT=8080
APP_ENV=development
APP_NAME=APEX_HRIS_Backend

# ==============================================================================
# OPTION 1: Supabase PostgreSQL Connection URL (Recommended for Cloud)
# Format: postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
# Or Direct: postgresql://postgres:[YOUR_PASSWORD]@db.fhcjzmxssmvkdaflzhsw.supabase.co:5432/postgres?sslmode=require
# ==============================================================================
DATABASE_URL=postgresql://postgres.fhcjzmxssmvkdaflzhsw:[YOUR_SUPABASE_PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require

# ==============================================================================
# OPTION 2: Individual Parameter Fallbacks
# ==============================================================================
DB_HOST=db.fhcjzmxssmvkdaflzhsw.supabase.co
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=[YOUR_SUPABASE_PASSWORD]
DB_NAME=postgres
DB_SSLMODE=require
DB_TIMEZONE=Asia/Manila

# JWT Configuration
JWT_SECRET=apex-enterprise-jwt-super-secret-key-2026
JWT_EXPIRATION_HOURS=24
JWT_ISSUER=apex-hris-enterprise-api

# Storage Configuration
STORAGE_PATH=./storage
